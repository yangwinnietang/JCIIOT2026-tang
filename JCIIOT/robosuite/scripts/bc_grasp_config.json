{
  "algo_name": "bc",
  "experiment": {
    "name": "grasp_bc",
    "save": {
      "enabled": true,
      "every_n_epochs": 50,
      "epochs": [150],
      "on_best_validation": false,
      "on_best_rollout_return": false,
      "on_best_rollout_success_rate": false
    },
    "rollout": {
      "enabled": false,
      "n": 0,
      "horizon": 400,
      "rate": 50,
      "warmstart": 0,
      "terminate_on_success": true
    }
  },
  "train": {
    "num_epochs": 150,
    "batch_size": 64,
    "seq_length": 1,
    "hdf5_cache_mode": "all",
    "dataset_keys": ["actions"],
    "hdf5_normalize_obs": false,
    "num_data_workers": 4,
    "cuda": true
  },
  "observation": {
    "modalities": {
      "obs": {
        "low_dim": [
          "robot0_left_eef_pos", "robot0_left_eef_quat", "robot0_left_gripper_qpos",
          "robot0_right_eef_pos", "robot0_right_eef_quat", "robot0_right_gripper_qpos"
        ],
        "rgb": [],
        "depth": [],
        "scan": []
      },
      "goal": {
        "low_dim": [],
        "rgb": [],
        "depth": [],
        "scan": []
      }
    },
    "encoder": {
      "low_dim": {
        "core_class": null,
        "core_kwargs": {},
        "obs_randomizer_class": null,
        "obs_randomizer_kwargs": {}
      },
      "rgb": {
        "core_class": "VisualCore",
        "core_kwargs": {
          "n_layers": 4,
          "pool_class": "SpatialSoftmax",
          "pool_kwargs": {},
          "flatten": true,
          "feat_dim": 64,
          "kernel_size": 3,
          "n_strides": 2,
          "activation": "relu",
          "out_channels": [32, 32, 64, 64]
        },
        "obs_randomizer_class": null,
        "obs_randomizer_kwargs": {}
      }
    }
  },
  "algo": {
    "rnn": {"enabled": false},
    "actor_layer_dims": [1024, 1024]
  }
}
